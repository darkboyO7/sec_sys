# ==============================================================================
# VAPT PLATFORM — BACKEND CONFIGURATION TEMPLATE (Prompt 49)
# Copy this file to backend/data/.env or backend/.env
# ==============================================================================

ENVIRONMENT=development
APP_NAME="VAPT Security Platform"
API_V1_STR=/api/v1
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///D:/alt/backend/data/vapt.db
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800

# Security & Secrets
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_32_CHAR_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Audit and Safety Controls
AUDIT_LOG_STRICT=True
SECRET_REDACTION_ENABLED=True
MAX_SCOPE_TARGETS_PER_PROJECT=500

# Execution Worker
EXECUTION_MODE=SUBPROCESS
WORKER_TIMEOUT_GRACE_PERIOD_SECONDS=3
WORKER_MAX_IPC_PAYLOAD_BYTES=10485760

# Evidence Storage Paths
EVIDENCE_DIR=D:/alt/backend/data/evidence
TEST_EVIDENCE_DIR=D:/alt/backend/data/test_evidence
