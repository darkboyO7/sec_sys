# ==============================================================================
# VAPT DEFENSIVE SECURITY PLATFORM — PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Copy this file to .env in production and populate all secret values.
# NEVER commit operational secrets or real certificates to version control.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
DEBUG=False
APP_NAME="VAPT Security Platform"
API_V1_STR=/api/v1

# Security & Cryptography (Generate via: openssl rand -hex 32)
# CRITICAL: Must be at least 32 characters long. Insecure/default keys will fail closed.
SECRET_KEY=replace_with_cryptographically_secure_random_64_character_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Production Database (PostgreSQL recommended for multi-worker concurrency)
# For PostgreSQL: postgresql+psycopg://vapt_app:STRONG_PASSWORD@db-host:5432/vapt_production
DATABASE_URL=postgresql+psycopg://vapt_app:STRONG_PASSWORD@localhost:5432/vapt_production
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800
DB_RETRY_MAX_ATTEMPTS=3
DB_RETRY_BASE_DELAY_SECONDS=0.05

# Strict CORS Policy (Explicit origins only; wildcard '*' is forbidden in production)
ALLOWED_ORIGINS=https://vapt.corp.internal,https://admin.vapt.corp.internal

# Defense & Audit Governance
AUDIT_LOG_STRICT=True
MAX_SCOPE_TARGETS_PER_PROJECT=500

# Isolated Worker Process Configuration
EXECUTION_MODE=SUBPROCESS
WORKER_TIMEOUT_GRACE_PERIOD_SECONDS=5
WORKER_MAX_IPC_PAYLOAD_BYTES=10485760
