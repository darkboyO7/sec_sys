# ==============================================================================
# VAPT PLATFORM — CANONICAL ENVIRONMENT CONFIGURATION TEMPLATE (Prompt 49)
# Copy this file to .env (or backend/data/.env) to configure runtime profiles.
# NEVER commit production secrets or live credentials to source control.
# ==============================================================================

# Runtime Environment Profile: 'development', 'testing', 'staging', or 'production'
ENVIRONMENT=development

# Application Information
APP_NAME="VAPT Security Platform"
API_V1_STR=/api/v1

# Debug Mode: Strictly forbidden (must be False) in 'staging' and 'production'
DEBUG=True

# Database URL:
#   Development: sqlite:///D:/alt/backend/data/vapt.db
#   Testing:     sqlite:///D:/alt/backend/data/vapt_test.db (or :memory:)
#   Staging/Prod: postgresql+psycopg2://vapt_app:REPLACE_WITH_STRONG_PASSWORD@db-host:5432/vapt_db
DATABASE_URL=sqlite:///D:/alt/backend/data/vapt.db

# Cryptographic Master Secret Key:
#   Minimum 32 characters, high entropy.
#   Default/sample keys are strictly rejected at startup in 'staging' and 'production'.
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_32_CHAR_SECRET_KEY

# Dedicated Credential Vault Encryption Key (Optional, derived from SECRET_KEY if omitted)
# CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_DEDICATED_32_BYTE_HEX_VAULT_KEY

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins:
#   Comma-separated list of trusted origins.
#   Wildcards ('*') and localhost origins are strictly rejected in 'staging' and 'production'.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Audit Log Strictness:
#   Must be True in 'staging' and 'production' to enforce immutable Merkle hash chaining.
AUDIT_LOG_STRICT=True

# Global Secret Redaction in logs, diagnostics, and error responses
SECRET_REDACTION_ENABLED=True

# Worker Subprocess Isolation Mode ('SUBPROCESS' or 'IN_PROCESS')
EXECUTION_MODE=SUBPROCESS
WORKER_TIMEOUT_GRACE_PERIOD_SECONDS=3
WORKER_MAX_IPC_PAYLOAD_BYTES=10485760

# Evidence Storage Paths
EVIDENCE_DIR=D:/alt/backend/data/evidence
TEST_EVIDENCE_DIR=D:/alt/backend/data/test_evidence
