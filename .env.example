# ==============================================================================
# VAPT Platform — Environment Configuration Template
# NOTE: Copy this file to .env before starting the server.
# NEVER commit .env to source control or expose secret keys in production.
# ==============================================================================

# Application Environment (development, staging, production, testing)
ENVIRONMENT=development
DEBUG=false
APP_NAME="VAPT Security Platform"
API_V1_STR="/api/v1"

# Database Configuration
# Local Development: SQLite with WAL mode enabled automatically
DATABASE_URL="sqlite:///./data/vapt.db"
# Production / PostgreSQL deployment example:
# DATABASE_URL="postgresql+psycopg2://vapt_user:replace_with_strong_password@localhost:5432/vapt_db"

# Security & Cryptography
# Generate a secure secret in production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev_insecure_secret_key_change_in_production_min_32_bytes_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Audit Logging & System Parameters
AUDIT_LOG_STRICT=true
MAX_SCOPE_TARGETS_PER_PROJECT=500
